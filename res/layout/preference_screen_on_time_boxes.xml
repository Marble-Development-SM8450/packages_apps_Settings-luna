<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:background="@drawable/screen_on_time_box_background"
        android:padding="16dp">

        <TextView
            android:id="@+id/used_since_charge_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/used_since_last_charge_label"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/used_since_charge_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:background="@drawable/screen_on_time_box_background"
        android:padding="16dp">

        <TextView
            android:id="@+id/screen_on_since_charge_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_on_since_last_charge_label"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/screen_on_since_charge_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

    </LinearLayout>

</LinearLayout>
